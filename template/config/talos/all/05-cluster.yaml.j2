machine:
  certSANs:
    - "127.0.0.1"
    - "#{ kubernetes.api.addr }#"
    #% for item in kubernetes.api.tls_sans %#
    - "#{ item }#"
    #% endfor %#
cluster:
  network:
    # Built-in CNI disabled: Cilium is the CNI (kube-proxy replacement too).
    cni:
      name: none
    podSubnets: ["#{ kubernetes.pod_cidr }#"]
    serviceSubnets: ["#{ kubernetes.svc_cidr }#"]
