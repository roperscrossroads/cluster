machine:
  certSANs:
    - "127.0.0.1"
    - "#{ kubernetes.api.addr }#"
    #% for item in kubernetes.api.tls_sans %#
    - "#{ item }#"
    #% endfor %#
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets: ["#{ kubernetes.pod_cidr }#"]
serviceSubnets: ["#{ kubernetes.svc_cidr }#"]
---
# Keep the runtime plane un-sandboxed (the 1.14 default for new configs is true;
# upgraded nodes keep false). Revisit deliberately: see the 1.14 notes on sandboxd.
apiVersion: v1alpha1
kind: SecurityProfileConfig
workloadIsolation: false
