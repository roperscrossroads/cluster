---
# Talos machine configs for the mini-cluster, assembled by topf
# (https://postfinance.github.io/topf/) from this file plus the strategic-merge
# patches in all/, control-plane/, worker/ and node/<host>/ (merged in that
# order, lexicographically within each directory). See README.md.
clusterName: kubernetes
clusterEndpoint: https://#{ kubernetes.api.addr }#:6443

# Keep talosVersion in step with the nodes: topf renders the machine-config
# contract for this version and builds the installer image from it.
# renovate: datasource=docker depName=ghcr.io/siderolabs/installer-base
talosVersion: v1.14.5
# renovate: datasource=docker depName=ghcr.io/siderolabs/kubelet
kubernetesVersion: v1.36.4

# Talos secrets bundle (sops, whole-file).
secretsPath: secrets.sops.yaml

nodes:
  #% for item in nodes %#
  - host: "#{ item.name }#"
    ip: "#{ item.address }#"
    role: #{ 'control-plane' if item.controller else 'worker' }#
    schematicId: "#{ item.schematic_id }#"
    data:
      #% if item.disk.startswith('/') %#
      installDisk: "#{ item.disk }#"
      installDiskSerial: ""
      #% else %#
      installDisk: ""
      installDiskSerial: "#{ item.disk }#"
      #% endif %#
      installer: "installer#{ '-secureboot' if item.secureboot | default(false, true) }#"
      macAddr: "#{ item.mac_addr | lower }#"
      mtu: #{ item.mtu | default(1500, true) }#
      encryptDisk: #{ item.encrypt_disk | default(false, true) | string | lower }#
      kernelModules: [#{ item.kernel_modules | default([], true) | join(', ') }#]
  #% endfor %#
