# TEMPLATE — do NOT apply. The real secret is created out-of-band, SOPS-encrypted
# with the cluster age key, saved as hermes-peer-secret.sops.yaml, and added to
# ../kustomization.yaml. See ../../README.md for the exact steps.
#
# API_SERVER_KEY : self-chosen (openssl rand -hex 32) — hermes api_server bearer.
# LITELLM_VKEY   : the `agno-hermes` LiteLLM virtual key (allowlist `local`),
#                  minted by ~/infra-new services/litellm-provision-keys.yml.
apiVersion: v1
kind: Secret
metadata:
  name: hermes-peer
  namespace: automation
type: Opaque
stringData:
  API_SERVER_KEY: "REPLACE_ME_openssl_rand_hex_32"
  LITELLM_VKEY: "REPLACE_ME_agno_hermes_vkey"
