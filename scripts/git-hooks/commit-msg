#!/bin/bash
# Reject commit messages that contain internal infrastructure identifiers.
# Rule: ~/.claude/CLAUDE.md, ~/notes/CLAUDE.md, ~/agents/governance.md.
# Bypass with `git commit --no-verify` only as a last resort.
#
# Install: ln -sf ../../scripts/git-hooks/commit-msg .git/hooks/commit-msg

set -euo pipefail
msg_file="$1"
msg=$(grep -v '^#' "$msg_file" || true)

# Patterns live in scripts/trust-tier/message-denylist.txt — the single source
# of truth shared with scripts/trust-tier/scan.sh (the pre-push + CI guard).
root="$(git rev-parse --show-toplevel)"
mapfile -t forbidden < <(grep -vE '^[[:space:]]*(#|$)' \
  "$root/scripts/trust-tier/message-denylist.txt" 2>/dev/null || true)

for pat in "${forbidden[@]}"; do
  if echo "$msg" | grep -Eq "$pat"; then
    match=$(echo "$msg" | grep -Eo "$pat" | head -1)
    cat >&2 <<EOF
✗ commit message contains an internal infrastructure identifier.

  matched: ${match}
  pattern: ${pat}

  Rule: don't put hostnames / IPs / internal DNS names in commit
  subjects or bodies. They live in (encrypted) config or the
  Backstage catalog (backstage.lab.ropxr.dev /
  git.lab.ropxr.dev/dev/homelab-catalog), not in git history.

  See:  ~/.claude/CLAUDE.md (top-level rule + anti-examples)
        ~/notes/CLAUDE.md
        ~/agents/governance.md

  Bypass with --no-verify only if the leak is truly unavoidable
  (e.g. quoting a public upstream's own DNS name).
EOF
    exit 1
  fi
done
exit 0
